# Regression test for the start wrapper's single-instance guard
# (developing-today/code#2562): the guard reads /proc cmdlines through
# tr '\0' ' ' so its space-containing patterns can match. With a doubled
# backslash in the generated wrapper the translation targets a literal
# backslash and the digit 0 instead of NUL, the patterns can never
# match, and the guard silently reaps nothing. The deployed wrapper
# carried exactly that defect while the module source looked plausible,
# so this test pins the GENERATED bytes and the guard's behavior, not
# the source text: it builds the wrapper from the real module
# (common.nix, with the neighbouring cascade options stubbed), checks
# the tr line byte-for-byte, and runs the wrapper against a fake
# leftover server whose cmdline carries real NUL separators.
{ pkgs }:
let
  lib = pkgs.lib;

  stubOpenchamber = pkgs.writeShellApplication {
    name = "openchamber";
    text = ''
      echo "stub-openchamber-started"
    '';
  };

  stubOpencode = pkgs.writeShellApplication {
    name = "opencode";
    text = ''
      echo "stub-opencode"
    '';
  };

  # common.nix reads config.services.opencode and enables
  # services.mcpx; both option sets belong to other cascade layers,
  # so the test declares just the fields the wrapper touches.
  stubOptions = {
    options.services.opencode = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
      };
      hostname = lib.mkOption {
        type = lib.types.str;
        default = "127.0.0.1";
      };
      port = lib.mkOption {
        type = lib.types.port;
        default = 4096;
      };
      package = lib.mkOption {
        type = lib.types.package;
        default = stubOpencode;
      };
    };
    options.services.mcpx = {
      enable = lib.mkOption {
        type = lib.types.bool;
        default = false;
      };
    };
  };

  eval = lib.evalModules {
    modules = [
      stubOptions
      ./modules/common.nix
      {
        services.openchamber = {
          enable = true;
          package = stubOpenchamber;
          port = 3999;
          opencode.attach = false;
        };
      }
    ];
    specialArgs = {
      inherit pkgs;
    };
  };

  wrapper = eval.config.services.openchamber.startWrapper;
in
pkgs.runCommand "openchamber-start-wrapper-guard-test" { } ''
  set -euo pipefail
  wrapper=${wrapper}/bin/openchamber-start

  # The generated tr line, byte-for-byte: single backslash, and no
  # doubled-backslash variant anywhere in the wrapper.
  if grep -Fq "tr '\\\\0' ' '" "$wrapper"; then
    echo "FAIL: generated wrapper has a doubled backslash in its tr line" >&2
    exit 1
  fi
  grep -Fq "tr '\0' ' '" "$wrapper" || {
    echo "FAIL: generated wrapper lacks the single-backslash tr line" >&2
    exit 1
  }

  # A fake leftover server on the wrapper's port, launched with the
  # guard's pattern split across separate argv entries
  # (openchamber / serve / --port / 3999): /proc separates the entries
  # with real NULs, so the translated cmdline can only contain the
  # space-joined pattern when the wrapper's tr really translates NULs
  # — with the doubled backslash both this fixture's spaces and the
  # match disappear. The port reaches the pattern through $PORT so
  # this script's own cmdline never matches the pattern it tests.
  # The fixture's interpreter is the store's runtimeShell, not
  # /bin/sh: a build sandbox is not guaranteed to bind-mount /bin/sh.
  PORT=3999
  fakebin="$(mktemp -d)"
  cat > "$fakebin/openchamber" <<'FAKE_EOF'
  #!${pkgs.runtimeShell}
  sleep 300 & wait
  FAKE_EOF
  chmod +x "$fakebin/openchamber"
  "$fakebin/openchamber" serve --port "$PORT" &
  leftover=$!
  sleep 1
  [ -d "/proc/$leftover" ] || {
    echo "FAIL: fake leftover exited before the wrapper ran" >&2
    exit 1
  }

  output="$("$wrapper" 2>&1)" || {
    echo "FAIL: wrapper exited non-zero: $output" >&2
    exit 1
  }
  case "$output" in
  *"stub-openchamber-started"*) ;;
  *)
    echo "FAIL: wrapper did not exec the server stub: $output" >&2
    exit 1
    ;;
  esac

  if [ -d "/proc/$leftover" ]; then
    echo "FAIL: guard did not reap the fake leftover (pid $leftover)" >&2
    kill -9 "$leftover" 2>/dev/null || true
    exit 1
  fi

  echo "start wrapper guard: generated tr line and leftover reaping verified"
  touch $out
''
